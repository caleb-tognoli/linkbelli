# Copy to .env and edit. Docker Compose reads .env automatically; .env is gitignored because
# Email__Password is a live credential.
#
#   cp .env.example .env
#
# Every value here has a working local default in docker-compose.yml, so an empty .env — or no
# .env at all — runs against Mailpit at http://localhost:8025 and sends nothing anywhere real.

# ---------------------------------------------------------------------------
# Sending mail
# ---------------------------------------------------------------------------
# Leave these alone to keep using Mailpit. To send real mail, fill in a provider.
#
# Brevo (free: 300/day):   Email__Host=smtp-relay.brevo.com  Email__Port=587  Email__UseTls=true
# Resend:                  Email__Host=smtp.resend.com       Email__Port=587  Email__UseTls=true
# Amazon SES:              Email__Host=email-smtp.<region>.amazonaws.com      Email__Port=587
#
# 587 upgrades with STARTTLS; 465 is TLS from the first byte. Getting that the wrong way round is
# the most common reason an SMTP config cannot connect at all.

Email__Host=mailpit
Email__Port=1025
Email__UseTls=false

# Brevo's SMTP password is NOT your login password — it is the separate SMTP key from
# "SMTP & API". Mailpit needs neither, which is why these are empty by default.
Email__Username=
Email__Password=

# Must be an address on a domain the provider has verified, or mail is rejected or filed as spam.
Email__FromAddress=no-reply@linkbelli.local
Email__FromName=Linkbelli

# Where links inside emails point. In production this is your real public web origin — every
# password reset link is built from it, and it is deliberately never taken from the request's
# Host header, which would let somebody make us mail a link to their own site.
Email__PublicUrl=http://localhost:5173

# ---------------------------------------------------------------------------
# Receiving mail (optional — see email-worker/README.md)
# ---------------------------------------------------------------------------
# The domain that receives mailed-in links. Only used to show somebody their inbox address;
# email-in works without it. Empty means the app says nothing about the feature rather than
# offering an address that goes nowhere.
Email__InboxDomain=
