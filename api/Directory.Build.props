<Project>

  <!--
    Settings every project in this solution shares.

    The five csproj files each repeated the same TargetFramework/Nullable/ImplicitUsings triple,
    so changing one meant remembering the other four.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      The .editorconfig at the repository root documents the C# conventions this codebase
      follows — file-scoped namespaces, primary constructors, braces — all at :suggestion, which
      the compiler ignores. They were followed anyway because one person wrote all of it. This
      makes the build check.

      AnalysisLevel is deliberately left at its default rather than raised to latest-recommended.
      That turns on the full CA set, which here means ~40 findings that are mostly style opinions
      about somebody else's good code — LoggerMessage delegates, interfaces that may not be named
      "Queue", methods that could be static. Adopting those is its own decision, not a by-product
      of making warnings visible.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      A warning nobody can see is a warning nobody fixes: before this the build printed them and
      carried on, so there was no way to tell 0 from 200. It was 0 at the time this went in, which
      is the only moment turning it on costs nothing.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      A lock file per project, so a restore resolves the same graph today and in six months, and
      so CI has something to key its NuGet cache on. Regenerated by a normal restore whenever the
      versions in Directory.Packages.props change; commit the result with the change.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
