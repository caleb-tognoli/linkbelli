<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Pinned ahead of the 2.0.0 that AspNetCore.OpenApi asks for: that version carries
         GHSA-v5pm-xwqc-g5wc. Its dependency range is [2.0.0, ), so this stays inside it. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.3" />
  </ItemGroup>

  <!-- Application + Contracts for logic/DTOs; Infrastructure only as the composition root (DI wiring). -->
  <ItemGroup>
    <ProjectReference Include="..\Linkbelli.Application\Linkbelli.Application.csproj" />
    <ProjectReference Include="..\Linkbelli.Contracts\Linkbelli.Contracts.csproj" />
    <ProjectReference Include="..\Linkbelli.Infrastructure\Linkbelli.Infrastructure.csproj" />
  </ItemGroup>

</Project>
