<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pure-logic parts of Infrastructure. Everything that needs a database is covered by the
    integration suite; what lives here is what does not, and has security consequences anyway —
    who can reach the job dashboard, whether a stored secret comes back.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Linkbelli.Infrastructure\Linkbelli.Infrastructure.csproj" />
  </ItemGroup>

</Project>
